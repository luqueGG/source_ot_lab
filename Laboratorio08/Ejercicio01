#include <iostream>
#include <vector>
#include <string>
#include <memory>

using namespace std;

// -------------------------------------------------------------------------
// 1. PRODUCTOS ABSTRACTOS (Categorías de la receta)
// -------------------------------------------------------------------------
class Receta {
protected:
    string nombre;
    string lugar;
    string dificultad;
    int tiempoMinutos;
    int porciones;
    vector<string> ingredientes;

public:
    Receta(string nom, string lug, string dif, int tiempo, int porc, vector<string> ingr)
        : nombre(move(nom)), lugar(move(lug)), dificultad(move(dif)),
          tiempoMinutos(tiempo), porciones(porc), ingredientes(move(ingr)) {}

    virtual ~Receta() = default;
    virtual string getCategoria() const = 0;

    void mostrarReceta() const {
        cout << "  --------------------------------------------------\n";
        cout << "  [" << getCategoria() << "] " << nombre << "\n";
        cout << "  Lugar / Origen : " << lugar << "\n";
        cout << "  Dificultad     : " << dificultad
             << " | Tiempo: " << tiempoMinutos << " min"
             << " | Porciones: " << porciones << "\n";
        cout << "  Ingredientes   :\n";
        for (const auto& ing : ingredientes) {
            cout << "    * " << ing << "\n";
        }
    }
};

class Entrada : public Receta {
public:
    using Receta::Receta;
    string getCategoria() const override { return "ENTRADA"; }
};

class PlatoFondo : public Receta {
public:
    using Receta::Receta;
    string getCategoria() const override { return "PLATO DE FONDO"; }
};

class Postre : public Receta {
public:
    using Receta::Receta;
    string getCategoria() const override { return "POSTRE"; }
};

