// -------------------------------------------------------------------------
// 4. ABSTRACT FACTORY Y FÁBRICAS CONCRETAS
// -------------------------------------------------------------------------
class FabricaRecetas {
public:
    virtual ~FabricaRecetas() = default;
    virtual unique_ptr<Entrada> crearEntrada() const = 0;
    virtual unique_ptr<PlatoFondo> crearPlatoFondo() const = 0;
    virtual unique_ptr<Postre> crearPostre() const = 0;
    virtual string getNombreCocina() const = 0;
};

class FabricaArequipena : public FabricaRecetas {
public:
    string getNombreCocina() const override { return "Cocina Tradicional Arequipeña"; }
    unique_ptr<Entrada> crearEntrada() const override { return make_unique<PastelDePapaArequipa>(); }
    unique_ptr<PlatoFondo> crearPlatoFondo() const override { return make_unique<AdoboArenqueno>(); }
    unique_ptr<Postre> crearPostre() const override { return make_unique<QuesoHelado>(); }
};

class FabricaCriolla : public FabricaRecetas {
public:
    string getNombreCocina() const override { return "Cocina Criolla Costeña"; }
    unique_ptr<Entrada> crearEntrada() const override { return make_unique<CausaLimena>(); }
    unique_ptr<PlatoFondo> crearPlatoFondo() const override { return make_unique<AjiDeGallina>(); }
    unique_ptr<Postre> crearPostre() const override { return make_unique<MazamorraMorada>(); }
};

// -------------------------------------------------------------------------
// 5. CLIENTE (Solicita menú completo o plato específico según la fábrica)
// -------------------------------------------------------------------------
void generarCartaPorEstilo(const FabricaRecetas& fabrica, int opcionPlato) {
    cout << "\n==================================================\n";
    cout << "LÍNEA DE RECETAS: " << fabrica.getNombreCocina() << "\n";
    cout << "==================================================\n";

    switch (opcionPlato) {
        case 1:
            fabrica.crearEntrada()->mostrarReceta();
            break;
        case 2:
            fabrica.crearPlatoFondo()->mostrarReceta();
            break;
        case 3:
            fabrica.crearPostre()->mostrarReceta();
            break;
        case 4:
            fabrica.crearEntrada()->mostrarReceta();
            fabrica.crearPlatoFondo()->mostrarReceta();
            fabrica.crearPostre()->mostrarReceta();
            break;
        default:
            cout << "Opción de plato no válida.\n";
    }
}

int main() {
    int estilo = -1;
    while (true) {
        cout << "\nSeleccione el estilo / lugar de cocina:\n";
        cout << "  1. Cocina Arequipeña\n";
        cout << "  2. Cocina Criolla\n";
        cout << "  0. Salir\n";
        cout << "Opción: ";
        cin >> estilo;

        if (estilo == 0) break;

        unique_ptr<FabricaRecetas> fabrica;
        if (estilo == 1) {
            fabrica = make_unique<FabricaArequipena>();
        } else if (estilo == 2) {
            fabrica = make_unique<FabricaCriolla>();
        } else {
            cout << "Estilo inválido, intente nuevamente.\n";
            continue;
        }

        int plato = 0;
        cout << "Seleccione receta (1: Entrada, 2: Plato de Fondo, 3: Postre, 4: Menú Completo): ";
        cin >> plato;

        generarCartaPorEstilo(*fabrica, plato);
    }

    cout << "Saliendo del generador de recetas...\n";
    return 0;
}
